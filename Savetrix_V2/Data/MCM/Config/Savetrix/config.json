{
  "$schema": "https://raw.githubusercontent.com/Exit-9B/MCM-Helper/main/docs/config.schema.json",
  "modName": "Savetrix",
  "displayName": "Savetrix",
  "minMcmVersion": 13,
  "content": [
    {
      "type": "header",
      "text": "Savetrix"
    },
    {
      "type": "text",
      "text": "Settings",
      "valueOptions": {
        "value": "Select Migration"
      }
    },
    {
      "type": "text",
      "text": "Hotkeys",
      "valueOptions": {
        "value": "Keyboard only"
      },
      "help": "Close all menus before using an export or import hotkey."
    }
  ],
  "pages": [
    {
      "pageDisplayName": "Migration",
      "content": [
        {
          "type": "header",
          "text": "Hotkeys",
          "position": 0
        },
        {
          "id": "iExportKey:Controls",
          "text": "Export profile",
          "type": "keymap",
          "help": "Keyboard only. Close all menus before exporting. Defaults to F10. This replaces profile.json.",
          "valueOptions": {
            "sourceType": "ModSettingInt"
          },
          "position": 2
        },
        {
          "id": "iImportKey:Controls",
          "text": "Import profile",
          "type": "keymap",
          "help": "Keyboard only. Close all menus before importing. Defaults to F11. Back up the destination save first.",
          "valueOptions": {
            "sourceType": "ModSettingInt"
          },
          "position": 4
        },
        {
          "type": "header",
          "text": "Selective Import",
          "position": 8
        },
        {
          "id": "bStats:Import",
          "text": "Stats / Level",
          "type": "toggle",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          },
          "position": 10
        },
        {
          "id": "bSkills:Import",
          "text": "Skills / Legendary",
          "type": "toggle",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          },
          "position": 12
        },
        {
          "id": "bPerks:Import",
          "text": "Perks",
          "type": "toggle",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          },
          "position": 14
        },
        {
          "id": "bSpells:Import",
          "text": "Spells / Powers",
          "type": "toggle",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          },
          "position": 16
        },
        {
          "id": "bShouts:Import",
          "text": "Shouts / Words",
          "type": "toggle",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          },
          "position": 18
        },
        {
          "id": "bInventory:Import",
          "text": "Inventory",
          "type": "toggle",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          },
          "position": 20
        },
        {
          "id": "bQuests:Import",
          "text": "Supported Quests",
          "type": "toggle",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          },
          "position": 22
        },
        {
          "type": "header",
          "text": "After Import",
          "position": 1
        },
        {
          "type": "text",
          "text": "Required",
          "valueOptions": {
            "value": "Save and restart via SKSE"
          },
          "position": 3,
          "help": "Save in a new slot, quit Skyrim to desktop, restart through SKSE, then load the save."
        }
      ]
    }
  ],
  "cursorFillMode": "topToBottom"
}
